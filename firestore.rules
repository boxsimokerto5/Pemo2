rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /cars/{carId} {
      allow read: if true;
      allow write: if true;
    }

    match /loans/{loanId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
